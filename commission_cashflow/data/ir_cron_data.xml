<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_cashflow_week_mail" model="ir.cron">
        <field name="name">Commission: weekly cashflow email</field>
        <field name="model_id" ref="model_commission_cashflow_week" />
        <field name="state">code</field>
        <field name="code">model._cron_email_previous_week()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field
            name="nextcall"
            eval="(DateTime.now() + timedelta(days=7 - DateTime.now().weekday())).strftime('%Y-%m-%d 06:00:00')"
        />
        <field name="priority">15</field>
        <field name="active" eval="True" />
    </record>
</odoo>
