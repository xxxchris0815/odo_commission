<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="invoice_line_agent_tree_cashflow" model="ir.ui.view">
        <field name="model">account.invoice.line.agent</field>
        <field name="inherit_id" ref="account_commission_oca.invoice_line_agent_tree" />
        <field name="arch" type="xml">
            <field name="agent_id" position="after">
                <field name="agent_role" />
            </field>
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-muted">monthly_staffel</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="monthly_staffel" column_invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
