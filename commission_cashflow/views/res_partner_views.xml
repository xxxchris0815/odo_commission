<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form_agent_role" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="commission_oca.view_partner_form_agent" />
        <field name="arch" type="xml">
            <field name="agent_type" position="after">
                <field name="agent_role" invisible="not agent" />
            </field>
            <field name="commission_id" position="after">
                <field
                    name="opener_commission_id"
                    invisible="not agent or agent_role != 'closer'"
                />
            </field>
        </field>
    </record>
</odoo>
